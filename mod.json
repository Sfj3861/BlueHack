{
  "geode": "5.11.2",
  "version": "v0.2.0",
  "gd": {
    "android": "2.2081"
  },
  "id": "sfj3861.bluehack",
  "name": "BlueHack",
  "developer": "Sfj3861",
  "description": "Mobile-first Geometry Dash utility menu with configurable shortcuts and optional Frame-Guard controls.",
  "early-load": false,
  "tags": [
    "gameplay",
    "utility",
    "customization",
    "interface"
  ],
  "links": {
    "source": "https://github.com/Sfj3861/BlueHack"
  },
  "settings": {
    "toggle-menu": {
      "name": "Open/close BlueHack",
      "type": "keybind",
      "default": "RightControl",
      "category": "gameplay"
    },
    "toggle-speedhack": {
      "name": "Toggle speedhack",
      "type": "keybind",
      "default": "F6",
      "category": "gameplay"
    },
    "toggle-noclip": {
      "name": "Toggle noclip",
      "type": "keybind",
      "default": "F7",
      "category": "gameplay"
    },
    "speedhack-enabled": {
      "name": "Speedhack enabled",
      "type": "bool",
      "default": false
    },
    "noclip-enabled": {
      "name": "Noclip enabled",
      "type": "bool",
      "default": false
    },
    "hitboxes-enabled": {
      "name": "Frame-Guard hitboxes",
      "type": "bool",
      "default": true
    },
    "trajectory-enabled": {
      "name": "Frame-Guard trajectory",
      "type": "bool",
      "default": true
    },
    "player-bounds-enabled": {
      "name": "Frame-Guard player bounds",
      "type": "bool",
      "default": true
    },
    "toggle-trajectory": {
      "name": "Toggle trajectory",
      "type": "keybind",
      "default": "F8",
      "category": "gameplay"
    },
    "toggle-hitboxes": {
      "name": "Toggle hitboxes",
      "type": "keybind",
      "default": "F9",
      "category": "gameplay"
    },
    "toggle-player-bounds": {
      "name": "Toggle player bounds",
      "type": "keybind",
      "default": "F10",
      "category": "gameplay"
    }
  }
}
